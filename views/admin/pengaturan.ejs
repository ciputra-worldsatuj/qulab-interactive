<div class="space-y-6 max-w-lg">
  <div>
    <h1 class="text-2xl font-bold text-[#1B1B2F]">Pengaturan Akun</h1>
    <p class="text-sm text-[#5A5A72] mt-1">Ganti kata sandi login host/admin sistem QuLab.</p>
  </div>

  <!-- Alert Notifikasi -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-3 bg-emerald-50 border border-[#1F8A57] text-[#1F8A57] rounded-lg text-xs font-medium flex items-center gap-2">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-3 bg-red-50 border border-[#C93A40] text-[#C93A40] rounded-lg text-xs font-medium flex items-center gap-2">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span><%= error %></span>
    </div>
  <% } %>

  <div class="bg-white rounded-xl border border-[#DADAE6] shadow-sm p-6">
    <form action="/admin/pengaturan/ganti-password" method="POST" class="space-y-4">
      <div>
        <label for="password_lama" class="block text-xs font-semibold text-[#1B1B2F] mb-1">Password Saat Ini</label>
        <input type="password" id="password_lama" name="password_lama" class="w-full px-3 py-2 border border-[#DADAE6] rounded-lg text-sm focus:outline-none focus:border-[#5B3FD1]" placeholder="Masukkan password lama" required>
      </div>

      <div>
        <label for="password_baru" class="block text-xs font-semibold text-[#1B1B2F] mb-1">Password Baru (Min 6 Karakter)</label>
        <input type="password" id="password_baru" name="password_baru" minlength="6" class="w-full px-3 py-2 border border-[#DADAE6] rounded-lg text-sm focus:outline-none focus:border-[#5B3FD1]" placeholder="Minimal 6 karakter" required>
      </div>

      <div>
        <label for="konfirmasi_password" class="block text-xs font-semibold text-[#1B1B2F] mb-1">Konfirmasi Password Baru</label>
        <input type="password" id="konfirmasi_password" name="konfirmasi_password" minlength="6" class="w-full px-3 py-2 border border-[#DADAE6] rounded-lg text-sm focus:outline-none focus:border-[#5B3FD1]" placeholder="Ulangi password baru" required>
      </div>

      <div class="pt-4 border-t border-[#DADAE6]">
        <button type="submit" class="w-full bg-[#5B3FD1] hover:bg-[#4A31B0] text-white font-semibold py-2.5 px-4 rounded-lg text-sm transition-colors">
          Simpan Perubahan Password
        </button>
      </div>
    </form>
  </div>
</div>
