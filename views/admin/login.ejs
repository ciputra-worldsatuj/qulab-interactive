<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QuLab | Login Dosen</title>
  <link rel="stylesheet" href="/css/main.css">
</head>

<body class="bg-[#F7F7FB] text-[#1B1B2F] min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-sm bg-white rounded-xl shadow-sm border border-[#DADAE6] p-8">
    <div class="text-center mb-6">
      <div
        class="w-12 h-12 rounded-xl bg-[#5B3FD1] text-white font-bold flex items-center justify-center text-xl mx-auto mb-3 shadow-md">
        Q</div>
      <h1 class="text-xl font-bold text-[#1B1B2F]">Masuk Panel Dosen</h1>
      <p class="text-xs text-[#5A5A72] mt-1">Kuis Interaktif Real-Time</p>
    </div>

    <!-- Alert Galat (DS Sec 4.3) -->
    <% if (typeof error !=='undefined' && error) { %>
      <div
        class="mb-4 p-3 bg-red-50 border border-[#C93A40] text-[#C93A40] rounded-lg text-xs font-medium flex items-center gap-2">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>
          <%= error %>
        </span>
      </div>
      <% } %>

        <!-- Form Login Dosen (UF-01 / D-01) -->
        <form action="/auth/login" method="POST" class="space-y-4">
          <div>
            <label for="username" class="block text-xs font-semibold text-[#1B1B2F] mb-1">Username Dosen</label>
            <input type="text" id="username" name="username"
              class="w-full px-3 py-2 border border-[#DADAE6] rounded-lg text-sm focus:outline-none focus:border-[#5B3FD1]"
              placeholder="dosen" required autofocus>
          </div>

          <div>
            <label for="password" class="block text-xs font-semibold text-[#1B1B2F] mb-1">Password</label>
            <input type="password" id="password" name="password"
              class="w-full px-3 py-2 border border-[#DADAE6] rounded-lg text-sm focus:outline-none focus:border-[#5B3FD1]"
              placeholder="Password" required>
          </div>

          <button type="submit"
            class="w-full min-h-[44px] bg-[#5B3FD1] hover:bg-[#4A31B0] text-white font-semibold py-2.5 px-4 rounded-lg text-sm transition-colors mt-2 shadow-sm">
            Masuk
          </button>
        </form>

        <div class="mt-6 text-center text-xs text-[#5A5A72] border-t border-[#DADAE6] pt-4">
          Copyright &copy; 2026 &mdash; QuLab&excl; All Rights Reserved.
        </div>
  </div>
</body>

</html>