<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-[#1B1B2F]">Riwayat Sesi Kuis</h1>
      <p class="text-sm text-[#5A5A72] mt-1">Daftar sesi kuis yang telah selesai dilaksanakan beserta rekap nilai
        peserta.</p>
    </div>
  </div>

  <% if (typeof success !=='undefined' && success) { %>
    <div
      class="p-3 bg-emerald-50 border border-[#1F8A57] text-[#1F8A57] rounded-lg text-xs font-medium flex items-center gap-2">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span>
        <%= success %>
      </span>
    </div>
    <% } %>

      <!-- Riwayat Table Container (D-08, FR-RPT-01 sampai 04) -->
      <div class="bg-white rounded-xl border border-[#DADAE6] shadow-sm overflow-hidden">
        <table class="w-full text-left text-sm">
          <thead class="bg-[#F7F7FB] border-b border-[#DADAE6] text-[#5A5A72] text-xs uppercase font-semibold">
            <tr>
              <th class="px-6 py-3.5">Tanggal Pelaksanaan</th>
              <th class="px-6 py-3.5">Mata Kuliah</th>
              <th class="px-6 py-3.5 w-24">PIN</th>
              <th class="px-6 py-3.5 w-32">Peserta</th>
              <th class="px-6 py-3.5 w-32">Rata-rata Poin</th>
              <th class="px-6 py-3.5 text-right w-48">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#DADAE6]">
            <% if (typeof riwayatList !=='undefined' && riwayatList.length> 0) { %>
              <% riwayatList.forEach(function(r) { %>
                <tr class="hover:bg-[#F7F7FB] transition-colors">
                  <td class="px-6 py-4 text-[#1B1B2F] whitespace-nowrap">
                    <%= new Date(r.dibuat_pada).toLocaleDateString('id-ID', { day: 'numeric' , month: 'short' ,
                      year: 'numeric' , hour: '2-digit' , minute: '2-digit' }) %>
                  </td>
                  <td class="px-6 py-4 font-semibold text-[#1B1B2F]">
                    <%= r.matkul_nama %> (<%= r.jumlah_soal %> Soal)
                  </td>
                  <td class="px-6 py-4 font-mono font-bold text-[#5B3FD1]">
                    <%= r.pin %>
                  </td>
                  <td class="px-6 py-4 text-[#5A5A72]">
                    <%= r.total_peserta || 0 %> Mahasiswa
                  </td>
                  <td class="px-6 py-4 text-[#1B1B2F] font-medium">
                    <%= r.rata_rata_poin || 0 %>
                  </td>
                  <td class="px-6 py-4 text-right space-x-2 whitespace-nowrap">
                    <a href="/admin/riwayat/<%= r.id %>"
                      class="inline-flex items-center px-3 py-1.5 bg-[#5B3FD1] text-white rounded-lg text-xs font-medium hover:bg-[#4A31B0]">
                      Lihat Rekap
                    </a>
                    <form action="/admin/riwayat/<%= r.id %>/delete" method="POST" class="inline"
                      onsubmit="return confirm('Hapus seluruh riwayat dan rekap nilai sesi ini secara permanen?')">
                      <button type="submit"
                        class="inline-flex items-center px-2.5 py-1.5 border border-red-200 text-[#C93A40] rounded-lg text-xs font-medium hover:bg-red-50">
                        Hapus
                      </button>
                    </form>
                  </td>
                </tr>
                <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="6" class="px-6 py-12 text-center text-[#5A5A72]">
                        Belum ada riwayat pelaksanaan sesi kuis.
                      </td>
                    </tr>
                    <% } %>
          </tbody>
        </table>
      </div>
</div>