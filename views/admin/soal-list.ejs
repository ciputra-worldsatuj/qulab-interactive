<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-[#1B1B2F]">Bank Soal: <%= typeof matkulNama !== 'undefined' ? matkulNama : '' %></h1>
      <p class="text-sm text-[#5A5A72] mt-1">Kelola pertanyaan pilihan ganda 4 opsi untuk mata kuliah ini.</p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/admin/matkul" class="px-3.5 py-2 border border-[#DADAE6] bg-white text-[#1B1B2F] rounded-lg text-sm font-medium hover:bg-[#F7F7FB]">
        &larr; Kembali
      </a>
      <a href="/admin/matkul/<%= matkulId %>/soal/baru" class="px-4 py-2 bg-[#5B3FD1] text-white rounded-lg text-sm font-semibold hover:bg-[#4A31B0] flex items-center gap-2 shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Tambah Soal
      </a>
    </div>
  </div>

  <!-- Alert Notifikasi -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-3 bg-emerald-50 border border-[#1F8A57] text-[#1F8A57] rounded-lg text-xs font-medium flex items-center gap-2">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      <span><%= success %></span>
    </div>
  <% } %>

  <!-- Soal Table Container (D-04, FR-SOAL-01 sampai 07) -->
  <div class="bg-white rounded-xl border border-[#DADAE6] shadow-sm overflow-hidden">
    <table class="w-full text-left text-sm">
      <thead class="bg-[#F7F7FB] border-b border-[#DADAE6] text-[#5A5A72] text-xs uppercase font-semibold">
        <tr>
          <th class="px-6 py-3.5 w-12">No</th>
          <th class="px-6 py-3.5">Pertanyaan & Opsi</th>
          <th class="px-6 py-3.5 w-24">Waktu</th>
          <th class="px-6 py-3.5 w-24">Poin</th>
          <th class="px-6 py-3.5 text-right w-56">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#DADAE6]">
        <% if (typeof soalList !== 'undefined' && soalList.length > 0) { %>
          <% soalList.forEach(function(s, index) { %>
            <tr class="hover:bg-[#F7F7FB] transition-colors">
              <td class="px-6 py-4 font-bold text-[#5A5A72] align-top"><%= index + 1 %></td>
              <td class="px-6 py-4 align-top">
                <div class="font-medium text-[#1B1B2F] leading-snug mb-2"><%= s.teks %></div>
                
                <% if (s.gambar_path) { %>
                  <div class="mb-3">
                    <img src="<%= s.gambar_path %>" alt="Gambar Soal" class="max-h-24 rounded-lg border border-[#DADAE6] object-contain">
                  </div>
                <% } %>

                <!-- Opsi Jawaban Preview -->
                <div class="grid grid-cols-2 gap-2 text-xs">
                  <% if (s.opsi && s.opsi.length > 0) { %>
                    <% const labelOpsi = ['A', 'B', 'C', 'D']; %>
                    <% const warnaOpsi = ['bg-red-50 text-red-700 border-red-200', 'bg-blue-50 text-blue-700 border-blue-200', 'bg-amber-50 text-amber-700 border-amber-200', 'bg-emerald-50 text-emerald-700 border-emerald-200']; %>
                    <% s.opsi.forEach(function(op, oIdx) { %>
                      <div class="p-1.5 rounded border flex items-center justify-between <%= warnaOpsi[oIdx % 4] %>">
                        <span class="truncate"><strong><%= labelOpsi[oIdx % 4] %>:</strong> <%= op.teks %></span>
                        <% if (op.is_benar) { %>
                          <span class="text-xs font-bold text-[#1F8A57]" title="Kunci Jawaban Benar">&#10003;</span>
                        <% } %>
                      </div>
                    <% }); %>
                  <% } %>
                </div>
              </td>
              <td class="px-6 py-4 align-top text-[#5A5A72] whitespace-nowrap"><%= s.waktu_detik %>s</td>
              <td class="px-6 py-4 align-top font-semibold text-[#1B1B2F] whitespace-nowrap"><%= s.poin %></td>
              <td class="px-6 py-4 align-top text-right space-x-1.5 whitespace-nowrap">
                <!-- Salin Soal (FR-SOAL-05) -->
                <form action="/admin/soal/<%= s.id %>/copy" method="POST" class="inline">
                  <button type="submit" class="px-2.5 py-1.5 border border-[#DADAE6] bg-white text-[#1B1B2F] rounded-lg text-xs font-medium hover:bg-[#F7F7FB]" title="Salin Soal">
                    Salin
                  </button>
                </form>
                
                <!-- Ubah Soal -->
                <a href="/admin/soal/<%= s.id %>/ubah" class="px-2.5 py-1.5 border border-[#DADAE6] bg-white text-[#1B1B2F] rounded-lg text-xs font-medium hover:bg-[#F7F7FB]">
                  Ubah
                </a>

                <!-- Hapus Soal (FR-SOAL-04) -->
                <form action="/admin/soal/<%= s.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Peringatan: Menghapus soal ini akan menghapus data hasil jawaban terkait pada riwayat sesi. Lanjutkan?')">
                  <button type="submit" class="px-2.5 py-1.5 border border-red-200 text-[#C93A40] rounded-lg text-xs font-medium hover:bg-red-50">
                    Hapus
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="5" class="px-6 py-12 text-center text-[#5A5A72]">
              Belum ada soal pada mata kuliah ini. Silakan klik tombol <strong>+ Tambah Soal</strong> di atas.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
