<div class="space-y-6">
  <!-- Detail Header & Ekspor CSV (D-09, FR-RPT-01 sampai 03) -->
  <div class="flex items-center justify-between bg-white p-6 rounded-xl border border-[#DADAE6] shadow-sm">
    <div>
      <div class="flex items-center gap-2 text-xs font-bold text-[#5B3FD1] uppercase tracking-wider mb-1">
        PIN: <span class="font-mono text-base font-black">
          <%= sesi.pin %>
        </span> &bull;
        <span>
          <%= new Date(sesi.dibuat_pada).toLocaleDateString('id-ID', { day: 'numeric' , month: 'short' , year: 'numeric'
            }) %>
        </span>
      </div>
      <h1 class="text-2xl font-bold text-[#1B1B2F]">Rekap Nilai: <%= sesi.matkul_nama %>
      </h1>
      <p class="text-xs text-[#5A5A72] mt-1">Total <%= sesi.jumlah_soal %> Soal &bull; Poin Maksimal: <%= maxPoin %>
      </p>
    </div>

    <div class="flex items-center gap-3">
      <a href="/admin/riwayat"
        class="px-3.5 py-2 border border-[#DADAE6] bg-white text-[#1B1B2F] rounded-lg text-sm font-medium hover:bg-[#F7F7FB]">
        &larr; Riwayat
      </a>
      <a href="/admin/riwayat/<%= sesi.id %>/csv"
        class="px-4 py-2 bg-[#1F8A57] text-white rounded-lg text-sm font-semibold hover:bg-emerald-700 flex items-center gap-2 shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Ekspor File CSV
      </a>
    </div>
  </div>

  <!-- Tabel Peringkat Rekap Nilai Mahasiswa -->
  <div class="bg-white rounded-xl border border-[#DADAE6] shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-[#DADAE6]">
      <h2 class="font-bold text-[#1B1B2F]">Peringkat Hasil Kuis (<%= pesertaList.length %> Mahasiswa)</h2>
    </div>

    <table class="w-full text-left text-sm">
      <thead class="bg-[#F7F7FB] border-b border-[#DADAE6] text-[#5A5A72] text-xs uppercase font-semibold">
        <tr>
          <th class="px-6 py-3.5 w-16 text-center">Peringkat</th>
          <th class="px-6 py-3.5">Nama Peserta</th>
          <th class="px-6 py-3.5 w-32">Total Poin</th>
          <th class="px-6 py-3.5 w-32">Nilai Akhir (%)</th>
          <th class="px-6 py-3.5 w-36">Total Waktu</th>
          <th class="px-6 py-3.5 w-24 text-center">Benar</th>
          <th class="px-6 py-3.5 w-24 text-center">Salah</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#DADAE6]">
        <% if (pesertaList && pesertaList.length> 0) { %>
          <% pesertaList.forEach(function(p) { %>
            <tr
              class="hover:bg-[#F7F7FB] transition-colors <%= p.peringkat === 1 ? 'bg-amber-50/40 font-semibold' : '' %>">
              <td class="px-6 py-4 text-center">
                <% if (p.peringkat===1) { %>
                  <span
                    class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-[#F5A524] text-white text-xs font-black shadow-sm">1</span>
                  <% } else if (p.peringkat===2) { %>
                    <span
                      class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-gray-400 text-white text-xs font-black shadow-sm">2</span>
                    <% } else if (p.peringkat===3) { %>
                      <span
                        class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-amber-700 text-white text-xs font-black shadow-sm">3</span>
                      <% } else { %>
                        <span class="text-xs font-semibold text-[#5A5A72]">
                          <%= p.peringkat %>
                        </span>
                        <% } %>
              </td>
              <td class="px-6 py-4 text-[#1B1B2F]">
                <%= p.nama %>
              </td>
              <td class="px-6 py-4 font-mono font-bold text-[#5B3FD1]">
                <%= p.total_poin %>
              </td>
              <td
                class="px-6 py-4 font-bold text-base <%= p.persentase >= 75 ? 'text-[#1F8A57]' : (p.persentase >= 50 ? 'text-[#F5A524]' : 'text-[#C93A40]') %>">
                <%= p.persentase %>%
              </td>
              <td class="px-6 py-4 text-[#5A5A72] tabular-nums">
                <%= p.total_waktu_detik %>s
              </td>
              <td class="px-6 py-4 text-center text-[#1F8A57] font-semibold">
                <%= p.jumlah_benar || 0 %>
              </td>
              <td class="px-6 py-4 text-center text-[#C93A40] font-semibold">
                <%= p.jumlah_salah || 0 %>
              </td>
            </tr>
            <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="px-6 py-12 text-center text-[#5A5A72]">
                    Tidak ada data peserta pada sesi kuis ini.
                  </td>
                </tr>
                <% } %>
      </tbody>
    </table>
  </div>
</div>