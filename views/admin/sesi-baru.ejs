<div class="space-y-6 max-w-xl">
  <div>
    <h1 class="text-2xl font-bold text-[#1B1B2F]">Buat Sesi Kuis Baru</h1>
    <p class="text-sm text-[#5A5A72] mt-1">Pilih mata kuliah dan jumlah soal N acak untuk kuis kelas interaktif.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-3 bg-red-50 border border-[#C93A40] text-[#C93A40] rounded-lg text-xs font-medium flex items-center gap-2">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span><%= error %></span>
    </div>
  <% } %>

  <div class="bg-white rounded-xl border border-[#DADAE6] shadow-sm p-6">
    <form action="/admin/sesi/baru" method="POST" class="space-y-5">
      <!-- Pilih Matkul (FR-SES-01) -->
      <div>
        <label for="matkul_id" class="block text-xs font-semibold text-[#1B1B2F] mb-1">Mata Kuliah *</label>
        <select id="matkul_id" name="matkul_id" class="w-full px-3 py-2 border border-[#DADAE6] rounded-lg text-sm bg-white focus:outline-none focus:border-[#5B3FD1]" required onchange="updateMaxSoal(this)">
          <option value="">-- Pilih Mata Kuliah --</option>
          <% if (typeof matkulList !== 'undefined' && matkulList.length > 0) { %>
            <% matkulList.forEach(function(m) { %>
              <option value="<%= m.id %>" data-count="<%= m.jumlah_soal || 0 %>">
                <%= m.nama %> (<%= m.jumlah_soal || 0 %> Soal Tersedia)
              </option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <!-- Jumlah Soal N Acak (FR-SES-02) -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="jumlah_soal" class="block text-xs font-semibold text-[#1B1B2F]">Jumlah Soal Acak (N) *</label>
          <span id="soal-info" class="text-[11px] text-[#5A5A72]">Pilih mata kuliah terlebih dahulu</span>
        </div>
        <input type="number" id="jumlah_soal" name="jumlah_soal" min="1" max="100" value="10" class="w-full px-3 py-2 border border-[#DADAE6] rounded-lg text-sm focus:outline-none focus:border-[#5B3FD1]" required>
        <p class="text-xs text-[#5A5A72] mt-1.5">
          Sistem akan mengacak urutan soal dan mengacak posisi opsi pilihan jawaban untuk setiap peserta.
        </p>
      </div>

      <div class="pt-4 border-t border-[#DADAE6]">
        <button type="submit" class="w-full min-h-[44px] bg-[#5B3FD1] hover:bg-[#4A31B0] text-white font-bold py-3 px-4 rounded-lg text-sm transition-colors shadow-sm">
          Buat Sesi & Buka Lobby
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function updateMaxSoal(selectEl) {
    const selected = selectEl.options[selectEl.selectedIndex];
    const count = parseInt(selected.getAttribute('data-count'), 10) || 0;
    const inputSoal = document.getElementById('jumlah_soal');
    const info = document.getElementById('soal-info');

    if (count > 0) {
      inputSoal.max = count;
      inputSoal.value = Math.min(10, count);
      info.textContent = `Tersedia ${count} soal`;
    } else {
      info.textContent = 'Mata kuliah ini belum memiliki soal';
    }
  }
</script>
