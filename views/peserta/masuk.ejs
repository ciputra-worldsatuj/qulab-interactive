<!-- M-01 Masuk Peserta (PIN & Nama) -->
<div class="flex-1 flex flex-col justify-center">
  <div class="text-center mb-8">
    <div
      class="w-16 h-16 rounded-2xl bg-[#5B3FD1] text-white font-extrabold flex items-center justify-center text-3xl mx-auto mb-4 shadow-lg">
      Q
    </div>
    <h1 class="text-2xl font-bold text-[#1B1B2F]">Bergabung ke Kuis</h1>
    <p class="text-xs text-[#5A5A72] mt-1">
      <% if (typeof pin !=='undefined' && pin) { %>
        PIN terisi otomatis dari QR Code. Masukkan nama Anda di bawah.
        <% } else { %>
          Masukkan PIN dari layar proyektor dan nama Anda
          <% } %>
    </p>
  </div>

  <!-- Alert Notifikasi / Kicked (M-07 / M-08) -->
  <% if (typeof error !=='undefined' && error) { %>
    <div
      class="mb-4 p-3 bg-red-50 border border-[#C93A40] text-[#C93A40] rounded-xl text-xs font-medium flex items-center gap-2">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>
        <%= error %>
      </span>
    </div>
    <% } %>

      <% if (typeof status !=='undefined' && status==='kicked' ) { %>
        <div
          class="mb-4 p-3 bg-amber-50 border border-[#F5A524] text-[#8F5F0A] rounded-xl text-xs font-medium flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span>Anda telah dikeluarkan dari sesi. Silakan masukkan PIN dan nama kembali jika ingin bergabung.</span>
        </div>
        <% } %>

          <form action="/main" method="GET" class="space-y-4">
            <div>
              <label for="pin" class="block text-xs font-bold text-[#1B1B2F] uppercase tracking-wider mb-1.5">
                PIN Kuis (4 Digit)
                <% if (typeof pin !=='undefined' && pin) { %>
                  <span class="text-[#1F8A57] text-[11px] font-semibold lowercase ml-1">(terdeteksi dari QR)</span>
                  <% } %>
              </label>
              <input type="text" id="pin" name="pin" maxlength="4" pattern="[0-9]{4}" inputmode="numeric"
                value="<%= typeof pin !== 'undefined' ? pin : '' %>"
                class="w-full text-center text-3xl font-mono font-bold tracking-widest py-3 px-4 border-2 border-[#DADAE6] rounded-xl focus:border-[#5B3FD1] focus:outline-none <%= (typeof pin !== 'undefined' && pin) ? 'bg-indigo-50/50 border-[#5B3FD1]' : '' %>"
                placeholder="0000" required <%=(typeof pin !=='undefined' && pin) ? '' : 'autofocus' %>>
            </div>

            <div>
              <label for="nama" class="block text-xs font-bold text-[#1B1B2F] uppercase tracking-wider mb-1.5">Nama
                Lengkap Anda</label>
              <input type="text" id="nama" name="nama" maxlength="100"
                class="w-full text-base py-3 px-4 border border-[#DADAE6] rounded-xl focus:border-[#5B3FD1] focus:outline-none"
                placeholder="Ketik nama Anda di sini..." required <%=(typeof pin !=='undefined' && pin) ? 'autofocus'
                : '' %>>
            </div>

            <!-- Tombol Masuk (Min 48px target sentuh per DS Sec 3) -->
            <div class="pt-2">
              <button type="submit"
                class="w-full min-h-[48px] bg-[#5B3FD1] hover:bg-[#4A31B0] text-white font-bold py-3.5 px-6 rounded-xl text-base shadow transition-all active:scale-[0.99]">
                Masuk Kuis
              </button>
            </div>
          </form>
</div>